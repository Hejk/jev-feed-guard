{
  "manifest_version": 3,
  "name": "JevFeedGuard（清净流）",
  "version": "0.2.0",
  "description": "用 TypeSafe AI 的 Jev 判断信息流里你不想看的内容与广告，自动隐藏或折叠。BYOK：自备 API Key，仅与 api.typesafe.ai 通信。",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*", "https://xiaohongshu.com/*"],
      "js": ["src/content/selectors.js", "src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JevFeedGuard（清净流）"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
